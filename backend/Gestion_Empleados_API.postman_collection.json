            },
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/{{resource}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "{{resource}}"
              ]
            },
            "description": "Envía un payload que carece de `cargo`, `departamento` y `sueldo`.\n\nResultado esperado: `400 Bad Request` señalando la obligatoriedad de los atributos faltantes."
          },
          "response": []
        },
        {
          "name": "04. Validación DTO - Tipos de Datos Incorrectos (POST 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Validar código HTTP 400 Bad Request",
                  "pm.test(\"Servidor rechaza con 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "// Validar rechazo de tipos erróneos",
                  "pm.test(\"Respuesta informa error de tipo de dato\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    const rawText = JSON.stringify(jsonData).toLowerCase();",
