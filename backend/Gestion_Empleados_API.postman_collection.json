                "{{apiVersion}}",
                "{{resource}}"
              ]
            },
            "description": "Caso de prueba extraído del README:\n`sueldo: -200` viola la regla de valor no negativo (> 0).\n\nResultado esperado: `400 Bad Request` con lista estructurada de campos inválidos."
          },
          "response": []
        },
        {
          "name": "03. Validación DTO - Campos Requeridos Faltantes (POST 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Validar código HTTP 400 Bad Request",
                  "pm.test(\"Servidor rechaza con 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "// Validar detección de múltiples campos ausentes",
                  "pm.test(\"Respuesta reporta campos ausentes requeridos\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    const rawText = JSON.stringify(jsonData).toLowerCase();",
                  "    pm.expect(rawText).to.satisfy(t => t.includes(\"cargo\") || t.includes(\"departamento\") || t.includes(\"sueldo\") || t.includes(\"required\"));",
                  "});"
                ],
                "type": "text/javascript"
